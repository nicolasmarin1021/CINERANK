# Opcional: clave de OMDb por defecto (https://www.omdbapi.com/apikey.aspx).
# Copia este archivo como .env.local y pon tu clave. También puedes escribirla
# dentro de la app en Ajustes.
EXPO_PUBLIC_OMDB_API_KEY=

# Opcional: clave de MDBList para el público de Rotten Tomatoes (https://mdblist.com/preferences/#api).
EXPO_PUBLIC_MDBLIST_API_KEY=
